# 企业制度与员工手册助手 - 环境变量配置模板
#
# 使用方式：
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 填入你的实际配置值
#   3. 应用启动时会自动读取

# ═══════════════════════════════════════════════════════════
# LLM 配置
# ═══════════════════════════════════════════════════════════

# DeepSeek 负责全部问答任务；阿里云百炼用于 Embedding 与 qwen3-rerank。
LLM_DEFAULT_PROVIDER=deepseek
LLM_PRIMARY_PROVIDER=deepseek
LLM_FAST_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=deepseek
LLM_CLIENT_TYPE=openai
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5
LLM_TIMEOUT_SECONDS=20
QUERY_REWRITE_TIMEOUT_SECONDS=2
GENERATION_TIMEOUT_SECONDS=20
CITATION_VERIFICATION_TIMEOUT_SECONDS=5

# DeepSeek（不要把真实 Key 提交到 Git）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼按量付费；API Key 与地域/Base URL 必须匹配
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 生成温度（0=确定性高，1=创造性高）
LLM_TEMPERATURE=0.3

# ═══════════════════════════════════════════════════════════
# Embedding 配置
# ═══════════════════════════════════════════════════════════

# 阿里云百炼 OpenAI-compatible Embedding
EMBEDDING_PROVIDER=dashscope

# text-embedding-v4 默认/推荐使用 1024 维
EMBEDDING_MODEL=text-embedding-v4

# 向量维度
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=2
EMBEDDING_TIMEOUT_SECONDS=3

# Query 路由与缓存
ADAPTIVE_MULTIQUERY_ENABLED=true
QUERY_REWRITE_CACHE_SIZE=512
QUERY_EMBEDDING_CACHE_SIZE=512
SIMPLE_QUERY_MIN_RRF_SCORE=0.025
RETRIEVAL_PARALLEL_WORKERS=8

# qwen3-rerank 使用 compatible-api（注意不是 Embedding 的 compatible-mode）
RERANKER_PROVIDER=qwen3
RERANKER_MODEL=qwen3-rerank
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANKER_CANDIDATE_K=40
RERANKER_TOP_N=6
# 基于本项目评测集校准，仅用于明显 OOD 拒答；Qwen 分数不可跨项目直接照搬
RERANKER_NOT_FOUND_THRESHOLD=0.30
RERANKER_TIMEOUT_SECONDS=4
RERANKER_MAX_RETRIES=2
RERANKER_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.

# ═══════════════════════════════════════════════════════════
# 向量数据库配置
# ═══════════════════════════════════════════════════════════

# 提供商: chroma
VECTORSTORE_PROVIDER=chroma

# Collection 名称
VECTORSTORE_COLLECTION=documents_v4_1024

# Chroma 持久化目录
CHROMA_PERSIST_DIR=./chroma_db

# ═══════════════════════════════════════════════════════════
# 元数据数据库
# ═══════════════════════════════════════════════════════════

DATABASE_PATH=./data/app.db

# ═══════════════════════════════════════════════════════════
# RAG 配置
# ═══════════════════════════════════════════════════════════

# 分块大小（字符数）
CHUNK_SIZE=512

# 块间重叠
CHUNK_OVERLAP=50

# 默认检索数量
TOP_K=6

# 相似度阈值（低于此值的结果被过滤）
SCORE_THRESHOLD=0.5

# 最大上下文 Token 数（控制传给 LLM 的上下文长度）
MAX_CONTEXT_TOKENS=5000
ANSWER_STATUS_THRESHOLD_HIGH=0.025
ANSWER_STATUS_THRESHOLD_LOW=0.012
CITATION_VERIFICATION_ENABLED=true
CITATION_VERIFICATION_STRICT=true

# 整条问答的最大预算，以及连续失败后的熔断恢复窗口
REQUEST_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ═══════════════════════════════════════════════════════════
# Agent 配置
# ═══════════════════════════════════════════════════════════

# 是否启用 Agent 模式
ENABLE_AGENT=true
AGENT_ROUTER_TYPE=langgraph

# ═══════════════════════════════════════════════════════════
# 应用配置
# ═══════════════════════════════════════════════════════════

# 调试模式
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,pptx,txt,md,html
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
